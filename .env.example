# Optional: Gemini für den Routen-Assistenten. Wenn beide Schlüssel gesetzt sind, wird Gemini verwendet.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite

# Alternative: OpenAI für den Routen-Assistenten.
OPENAI_API_KEY=
# Optional: Standardmodell überschreiben.
OPENAI_MODEL=gpt-5.6-sol

# Serverseitiger Schutz für die Admin-Seite.
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=

# Wird von einem verbundenen Vercel-Blob-Speicher automatisch gesetzt.
BLOB_READ_WRITE_TOKEN=
