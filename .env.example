# Optional: Aktiviert die OpenAI-gestützte Interpretation im Routen-Assistenten.
OPENAI_API_KEY=
# Optional: Standardmodell überschreiben.
OPENAI_MODEL=gpt-5.6-sol

# Serverseitiger Schutz für die Admin-Seite.
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=

# Wird von einem verbundenen Vercel-Blob-Speicher automatisch gesetzt.
BLOB_READ_WRITE_TOKEN=
